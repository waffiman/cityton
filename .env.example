# Public site
NEXT_PUBLIC_SITE_URL=https://www.city-ton.at

# Optional legacy contact webhook (unused)
# CONTACT_FORM_ENDPOINT=

# --- Admin panel ---

# Postgres connection string (Vercel Postgres / Neon / Supabase now; self-hosted on the VPS later)
DATABASE_URL=postgresql://user:password@localhost:5432/cityton?schema=public

# Admin login: a single shared password. Prefer the bcrypt hash; plain is a fallback for local dev.
# Generate a hash: node -e "console.log(require('bcryptjs').hashSync(process.argv[1],10))" 'your-password'
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=

# HMAC key that signs the admin session cookie. Use a long random string.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# S3-compatible object storage for product/blog images (Cloudflare R2, Backblaze B2, MinIO on the VPS).
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL images are served from (CDN / bucket public URL), no trailing slash.
S3_PUBLIC_BASE_URL=
